# ===== 模型配置 =====
# 模型提供商: anthropic | deepseek | openai | google | openai-compatible（自定义 OpenAI 兼容端点）
MODEL_PROVIDER=deepseek
# 模型 ID（deepseek: deepseek-v4-flash / deepseek-v4-pro）
MODEL_ID=deepseek-v4-flash

# ===== API Key（按使用的提供商填写）=====
ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ===== OpenAI 兼容端点（可选，如 vLLM / Ollama / LM Studio 等本地服务）=====
# 填写完整的 API 地址（含 /v1 路径）
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPAT_API_KEY=sk-xxx
# 可选：逗号分隔的模型 ID 列表（未设置时默认 ["gpt-4o-mini"]）
# OPENAI_COMPAT_MODELS=qwen2.5-72b,llama-3-70b

# ===== 上下文压缩（阶段 2）=====
# 累计 token 超过该值时，把最早的对话摘要化（默认 50000）
# MAX_CONTEXT_TOKENS=50000
# 压缩时保留的最近消息条数（默认 8）
# KEEP_RECENT_MESSAGES=8

# ===== 权限与审批（已迁移至文件配置）=====
# 审批超时、工具/路径白黑名单、命令/MCP 规则、权限模式、LLM Guardian 决策方
# 均统一存于 <baseDir>/permission/global.json（设置面板"审批"Tab 或直接编辑该文件）。
# 命令行/脚本覆盖：设置面板不再写入环境变量，历史 APPROVAL_* / APPROVAL_TIMEOUT_MS 已移除。

# ===== 情景记忆（阶段 4）=====
# 每次检索注入的历史 episode 条数（默认 5）
# MEMORY_RECALL_K=5

# ===== 并行工具执行（阶段 9）=====
# 单条消息含多个工具调用时同时执行（默认 parallel）；多文件任务更快
# TOOL_EXECUTION=parallel

# ===== LLM-as-Judge 自动评分（观测评估闭环）=====
# 默认关闭；开启后每次运行结束异步调用主模型打分(0-10)并写入评估记录
# PRYSM_LLM_JUDGE=1

# ===== 联网搜索（阶段 10）=====
# 搜索提供器: bing（默认，国内可直连） | duckduckgo
# WEB_SEARCH_PROVIDER=bing

# ===== 文件访问白名单 =====
# 允许 Agent 在工作区（agent-workdir）之外额外访问的目录（逗号分隔的绝对或相对路径）。
# 例如让 Agent 读写项目根目录下的 docs/ 或本机绝对路径：
# AGENT_ALLOWED_PATHS=../docs,/data/notes

# ===== 服务启动（standalone 部署）=====
# 运行 node .next/standalone/server.js 时的监听端口与地址
# 本地联调时也可配合 npm run dev 使用（next dev 默认 30123）
# PORT=30123
# HOSTNAME=0.0.0.0
