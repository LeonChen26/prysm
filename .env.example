# ===== 模型配置 =====
# 模型提供商: anthropic | deepseek | openai | google
MODEL_PROVIDER=deepseek
# 模型 ID（deepseek: deepseek-v4-flash / deepseek-v4-pro）
MODEL_ID=deepseek-v4-flash

# ===== API Key（按使用的提供商填写）=====
ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ===== 上下文压缩（阶段 2）=====
# 累计 token 超过该值时，把最早的对话摘要化（默认 50000）
# MAX_CONTEXT_TOKENS=50000
# 压缩时保留的最近消息条数（默认 8）
# KEEP_RECENT_MESSAGES=8

# ===== 工具审批（阶段 3）=====
# 敏感工具等待用户确认的超时毫秒数，超时视为拒绝（默认 120000）
# APPROVAL_TIMEOUT_MS=120000

# ===== 情景记忆（阶段 4）=====
# 每次检索注入的历史 episode 条数（默认 5）
# MEMORY_RECALL_K=5
