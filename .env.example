# ===== 模型配置 =====
# 模型提供商: anthropic | deepseek | openai | google
MODEL_PROVIDER=deepseek
# 模型 ID（deepseek: deepseek-v4-flash / deepseek-v4-pro）
MODEL_ID=deepseek-v4-flash

# ===== API Key（按使用的提供商填写）=====
ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ===== 上下文压缩（阶段 2）=====
# 累计 token 超过该值时，把最早的对话摘要化（默认 50000）
# MAX_CONTEXT_TOKENS=50000
# 压缩时保留的最近消息条数（默认 8）
# KEEP_RECENT_MESSAGES=8

# ===== 工具审批（阶段 3）=====
# 敏感工具等待用户确认的超时毫秒数，超时视为拒绝（默认 120000）
# APPROVAL_TIMEOUT_MS=120000

# ===== 审批规则化（阶段 6）=====
# 命中下列白名单的敏感操作自动放行，无需人工确认；未命中仍走人工审批。
# 完全免审批的工具名（逗号分隔）：
# APPROVAL_ALLOW_TOOLS=append_file,create_dir
# 路径放行规则（逗号分隔）：
#   - 以 / 结尾 → 目录前缀（相对 agent-workdir），如 notes/ 放行 notes/ 下所有文件
#   - 含 *      → 文件名通配，如 *.md 放行所有 .md 文件
#   - 其他      → 视为路径前缀
# APPROVAL_ALLOW_PATHS=notes/,docs/,*.md
# 命令放行规则（run_bash，按命令首行前缀匹配）：
#   如 `git push` 放行 `git push origin main`，`npm run` 放行所有 npm run 脚本
# APPROVAL_ALLOW_COMMANDS=git push,npm run

# ===== 强制拦截（黑名单，优先于白名单）=====
# 命中即直接拒绝、不进审批（安全兜底），并在前端提示"已被策略拦截"。
# 工具黑名单（逗号分隔）：
# APPROVAL_DENY_TOOLS=delete_file
# 路径黑名单（语法同 ALLOW_PATHS；.env 规则也会命中 .env.local 等隐藏文件）：
# APPROVAL_DENY_PATHS=.env,.git/
# 命令黑名单（run_bash，子串匹配：命令文本包含任一规则即拒绝）：
# APPROVAL_DENY_COMMANDS=rm -rf /,| sh

# ===== 情景记忆（阶段 4）=====
# 每次检索注入的历史 episode 条数（默认 5）
# MEMORY_RECALL_K=5

# ===== 并行工具执行（阶段 9）=====
# 单条消息含多个工具调用时同时执行（默认 parallel）；多文件任务更快
# TOOL_EXECUTION=parallel

# ===== 联网搜索（阶段 10）=====
# 搜索提供器: bing（默认，国内可直连） | duckduckgo
# WEB_SEARCH_PROVIDER=bing

# ===== 文件访问白名单 =====
# 允许 Agent 在工作区（agent-workdir）之外额外访问的目录（逗号分隔的绝对或相对路径）。
# 例如让 Agent 读写项目根目录下的 docs/ 或本机绝对路径：
# AGENT_ALLOWED_PATHS=../docs,/data/notes

# ===== 服务启动（standalone 部署）=====
# 运行 node .next/standalone/server.js 时的监听端口与地址
# 本地联调时也可配合 npm run dev 使用（next dev 默认 3000）
# PORT=3000
# HOSTNAME=0.0.0.0
